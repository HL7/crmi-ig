      "type": "element",
      "expression": "ValueSet"
    }
  ],
  "differential": {
    "element": [
      {
        "id": "Extension",
        "path": "Extension",
        "short": "Relative curation level of the codes in the value set",
        "definition": "Represents the steward's assessment of the completeness of curation for the value set, including whether relevant codes or referenced component value sets may be missing.",
        "min": 0,
        "max": "1",
        "constraint": [
            {
                "key": "ccov-1",
                "severity": "error",
                "human": "If level is 'partial', levelReason SHALL be provided.",
                "expression": "extension.where(url='level').value.coding.where(system = 'http://terminology.hl7.org/CodeSystem/curation-coverage-level-codes' and code ~ 'partial').exists() implies extension.where(url='levelReason').exists()"
            }
        ]
      },
      {
