  "version": "1.0.0",
  "name": "CRMICurationCoverageLevel",
  "title": "CRMI Curation Coverage Level",
  "status": "active",
  "experimental": false,
  "date": "2026-02-11",
  "publisher": "HL7 International / Clinical Decision Support",
  "description": "Indicates the qualitative curation level of the concept codes in a value set.",
  "purpose": "Provides a machine-readable signal describing whether the value set content has been fully curated or may contain gaps, supporting trust and fitness-for-use decisions in analytics and public health workflows.",
  "kind": "complex-type",
  "abstract": false,
  "type": "Extension",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Extension",
