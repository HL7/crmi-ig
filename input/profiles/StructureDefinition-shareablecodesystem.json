        "key": "shr-1",
        "severity": "error",
        "human": "If knowledge capabilities are stated, they SHALL include shareable",
        "expression": "extension('http://hl7.org/fhir/StructureDefinition/cqf-knowledgeCapability').exists() implies extension('http://hl7.org/fhir/StructureDefinition/cqf-knowledgeCapability').where(value = 'shareable').exists()"
      },
      {
        "key" : "scs-2",
        "severity" : "error",
        "human" : "If a codesystem contains example, fragment, or complete content, it must have at least one concept",
        "expression" : "content in ( 'example' | 'fragment' | 'complete' ) implies concept.exists()"
      }]
    },
